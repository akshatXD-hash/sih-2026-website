generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  APPLICANT
  CHANNEL_PARTNER
  REVIEWER
  ADMIN
}

enum Gender {
  FEMALE
  MALE
  TRANSGENDER
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum LoanCategory {
  MICRO_FINANCE
  TERM_LOAN
  EDUCATION_LOAN
}

enum ChannelPartnerType {
  BANK
  NBFC
  MICROFINANCE_INSTITUTION
  NGO
  COMMON_SERVICE_CENTRE
  SELF_HELP_GROUP
  EDUCATIONAL_INSTITUTION
  OTHER
}

enum ApplicationStatus {
  DRAFT
  EXTRACTION_PENDING
  EXTRACTION_COMPLETE
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  WITHDRAWN
}

enum DocumentType {
  AADHAAR
  PAN
  CASTE_CERTIFICATE
  ADDRESS_PROOF
  INCOME_PROOF
  BANK_STATEMENT
  PROJECT_REPORT
  EDUCATION_CERTIFICATE
  ADMISSION_LETTER
  FEE_STRUCTURE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
  VERIFIED
  REJECTED
}

model User {
  branchSupportReviews BranchSchemeSupport[]
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  name         String
  passwordHash String?  @map("password_hash")
  role         UserRole @default(APPLICANT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  applications      Application[]
  managedPartner    ChannelPartner?          @relation("PartnerManager")
  uploadedDocuments DocumentUpload[]         @relation("DocumentUploader")
  verifiedDocuments DocumentUpload[]         @relation("DocumentVerifier")
  applicationNotes  ApplicationNote[]        @relation("ApplicationNoteAuthor")
  statusChanges     ApplicationStatusEvent[] @relation("ApplicationStatusChangedBy")

  @@map("users")
}

model LoanScheme {
  branchSupportReviews BranchSchemeSupport[]
  id                    String       @id @default(cuid())
  slug                  String       @unique
  name                  String
  provider              String
  category              LoanCategory
  description           String
  minAmount             Decimal      @default(0) @map("min_amount") @db.Decimal(14, 2)
  maxAmount             Decimal      @map("max_amount") @db.Decimal(14, 2)
  minAnnualIncome       Decimal?     @map("min_annual_income") @db.Decimal(14, 2)
  maxAnnualIncome       Decimal?     @map("max_annual_income") @db.Decimal(14, 2)
  interestRateMin       Decimal?     @map("interest_rate_min") @db.Decimal(5, 2)
  interestRateMax       Decimal?     @map("interest_rate_max") @db.Decimal(5, 2)
  tenureMonthsMin       Int?         @map("tenure_months_min")
  tenureMonthsMax       Int?         @map("tenure_months_max")
  minAge                Int?         @map("min_age")
  maxAge                Int?         @map("max_age")
  projectCategories     String[]     @default([]) @map("project_categories")
  eligibleTrades        String[]     @default([]) @map("eligible_trades")
  eligibleGenders       Gender[]     @default([]) @map("eligible_genders")
  eligibleApplicantTags String[]     @default([]) @map("eligible_applicant_tags")
  collateralRequired    Boolean      @default(false) @map("collateral_required")
  eligibilityCriteria   Json?        @map("eligibility_criteria")
  requiredDocuments     String[]     @default([]) @map("required_documents")
  sourceUrl             String?      @map("source_url")
  sourceVerifiedAt      DateTime?    @map("source_verified_at")
  isActive              Boolean      @default(true) @map("is_active")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  applications Application[]

  @@index([category, isActive])
  @@index([maxAmount])
  @@map("loan_schemes")
}

model ChannelPartner {
  branchSupportReviews BranchSchemeSupport[]
  id                  String             @id @default(cuid())
  name                String
  type                ChannelPartnerType
  registrationNumber  String?            @unique @map("registration_number")
  email               String?            @unique
  phone               String?
  addressLine         String?            @map("address_line")
  district            String?
  state               String?
  pincode             String?
  serviceRadiusKm     Decimal?           @map("service_radius_km") @db.Decimal(7, 2)
  fundQuotaAmount     Decimal?           @map("fund_quota_amount") @db.Decimal(14, 2)
  availableFundAmount Decimal?           @map("available_fund_amount") @db.Decimal(14, 2)
  npaPercentage       Decimal?           @map("npa_percentage") @db.Decimal(5, 2)
  healthUpdatedAt     DateTime?          @map("health_updated_at")
  isVerified          Boolean            @default(false) @map("is_verified")
  isActive            Boolean            @default(true) @map("is_active")
  managerId           String?            @unique @map("manager_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // PostGIS is not natively queryable by Prisma. The initial migration enables
  // PostGIS before creating this nullable geography column and its GiST index.
  // Read and write `location` with Prisma raw SQL / TypedSQL.
  location Unsupported("geography(Point, 4326)")?

  manager      User?         @relation("PartnerManager", fields: [managerId], references: [id], onDelete: SetNull)
  applications Application[]

  @@index([district, state, isActive])
  @@index([location], map: "channel_partners_location_gist_idx", type: Gist)
  @@map("channel_partners")
}

model Application {
  id               String            @id @default(cuid())
  referenceNumber  String            @unique @default(cuid()) @map("reference_number")
  status           ApplicationStatus @default(DRAFT)
  userId           String            @map("user_id")
  loanSchemeId     String?           @map("loan_scheme_id")
  channelPartnerId String?           @map("channel_partner_id")
  preferredBankId  String?           @map("preferred_bank_id")

  // Structured output accepted from the external FastAPI AI service. These
  // fields stay nullable until extraction has completed.
  projectCategory String?  @map("project_category")
  requestedAmount Decimal? @map("requested_amount") @db.Decimal(14, 2)
  annualIncome    Decimal? @map("annual_income") @db.Decimal(14, 2)
  trade           String?
  gender          Gender?
  age             Int?
  applicantTags   String[] @default([]) @map("applicant_tags")

  aiOutput         Json?     @map("ai_output")
  aiConfidence     Decimal?  @map("ai_confidence") @db.Decimal(5, 4)
  aiServiceVersion String?   @map("ai_service_version")
  aiProcessedAt    DateTime? @map("ai_processed_at")
  submittedAt      DateTime? @map("submitted_at")
  decidedAt        DateTime? @map("decided_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  loanScheme     LoanScheme?              @relation(fields: [loanSchemeId], references: [id], onDelete: SetNull)
  channelPartner ChannelPartner?          @relation(fields: [channelPartnerId], references: [id], onDelete: SetNull)
  documents      DocumentUpload[]
  preferredBank BankDirectory? @relation(fields: [preferredBankId], references: [id], onDelete: SetNull)
  notes          ApplicationNote[]
  statusHistory  ApplicationStatusEvent[]
  planTasks ApplicationTask[]
  competencies ApplicantCompetency[]

  @@index([userId, createdAt])
  @@index([loanSchemeId, status])
  @@index([channelPartnerId, status])
  @@index([status, createdAt])
  @@map("applications")
}

model DocumentUpload {
  id                  String         @id @default(cuid())
  applicationId       String         @map("application_id")
  uploadedById        String         @map("uploaded_by_id")
  verifiedById        String?        @map("verified_by_id")
  type                DocumentType
  status              DocumentStatus @default(UPLOADED)
  originalFileName    String         @map("original_file_name")
  storageKey          String         @unique @map("storage_key")
  storageProvider     String         @default("cloudinary") @map("storage_provider")
  storageVersion      Int?           @map("storage_version")
  storageFormat       String?        @map("storage_format")
  storageResourceType String         @default("image") @map("storage_resource_type")
  storageDeliveryType String         @default("authenticated") @map("storage_delivery_type")
  mimeType            String         @map("mime_type")
  sizeBytes           Int            @map("size_bytes")
  checksum            String?
  extractedData       Json?          @map("extracted_data")
  ocrConfirmedAt      DateTime?      @map("ocr_confirmed_at")
  failureReason       String?        @map("failure_reason")
  verifiedAt          DateTime?      @map("verified_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  verifiedBy  User?       @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([applicationId, type])
  @@index([status, createdAt])
  @@map("document_uploads")
}

model ApplicationNote {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  authorId      String   @map("author_id")
  body          String
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      User        @relation("ApplicationNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@map("application_notes")
}

model ApplicationStatusEvent {
  id            String             @id @default(cuid())
  applicationId String             @map("application_id")
  changedById   String?            @map("changed_by_id")
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("ApplicationStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([toStatus, createdAt])
  @@map("application_status_events")
}

// Public geographic directory. These records do not establish scheme participation.
model SearchPlace {
  id String @id
  name String
  nameKey String @map("name_key")
  aliases String[] @default([])
  district String?
  state String?
  pincode String?
  kind String
  population Int @default(0)
  latitude Float
  longitude Float
  sourceUrl String @map("source_url")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz
  @@index([nameKey(ops: raw("text_pattern_ops"))], map: "search_places_name_key_idx")
  @@index([aliases], type: Gin, map: "search_places_aliases_idx")
  @@index([pincode], map: "search_places_pincode_idx")
  @@map("search_places")
}

model BankDirectory {
  preferredApplications Application[]
  branchSupportReviews BranchSchemeSupport[]
  @@index([pincode], map: "bank_directory_pincode_idx")
  id String @id
  name String
  addressLine String? @map("address_line")
  district String?
  state String?
  pincode String?
  phone String?
  sourceUrl String @map("source_url")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz
  location Unsupported("geography(Point, 4326)")
  @@index([location], type: Gist, map: "bank_directory_location_gist_idx")
  @@map("bank_directory")
}

model BranchSchemeSupport {
  id Int @id @default(autoincrement())
  schemeId String @map("scheme_id")
  bankId String? @map("bank_id")
  partnerId String? @map("partner_id")
  status String
  evidenceUrl String @map("evidence_url")
  notes String
  verifiedAt DateTime @map("verified_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  reviewerId String @map("reviewer_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  scheme LoanScheme @relation(fields: [schemeId], references: [id], onDelete: Restrict)
  bank BankDirectory? @relation(fields: [bankId], references: [id], onDelete: Restrict)
  partner ChannelPartner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  @@index([schemeId, bankId, id(sort: Desc)], map: "branch_scheme_bank_idx")
  @@index([schemeId, partnerId, id(sort: Desc)], map: "branch_scheme_partner_idx")
  @@map("branch_scheme_support")
}

model ApplicationTask {
  id String @id @default(cuid())
  applicationId String @map("application_id")
  taskKey String @map("task_key")
  completedAt DateTime? @map("completed_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, taskKey])
  @@map("application_tasks")
}

model ApplicantCompetency {
  id String @id @default(cuid())
  applicationId String @map("application_id")
  skillKey String @map("skill_key")
  level String
  updatedAt DateTime @updatedAt @map("updated_at")
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, skillKey])
  @@map("applicant_competencies")
}

# Runtime URL: use Neon's pooled connection string (hostname contains `-pooler`).
DATABASE_URL="postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Prisma CLI URL: use the matching direct Neon connection string.
DIRECT_URL="postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional for `prisma migrate dev`: point this at a separate Neon branch/database.
# Never reuse DATABASE_URL or DIRECT_URL here because Prisma resets the shadow DB.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@EP-SHADOW.REGION.aws.neon.tech/neondb?sslmode=require"

# External AI/ML service only. The fullstack app will call or mock this service;
# this repository must not implement the FastAPI service.
AI_SERVICE_URL="http://localhost:8000"
